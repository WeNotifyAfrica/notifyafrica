# Reverse proxy — domains come from environment (04_Prompt §8). Caddy reads
# these from the shell environment it's launched with (docker-compose.prod.yml's
# env_file); substitute the placeholders or export them before `caddy run`.
# Automatic HTTPS (Let's Encrypt) kicks in on its own once each domain's DNS
# A record points at this VPS — no cert config needed here.
{
    email {$ACME_EMAIL:admin@example.com}
}

{$PUBLIC_SITE_DOMAIN:www.wenotifyafrica.com} {
    reverse_proxy website:3000
}

{$CONSOLE_DOMAIN:console.wenotifyafrica.com} {
    reverse_proxy console:3001
}

{$ADMIN_DOMAIN:backoffice.wenotifyafrica.com} {
    reverse_proxy admin:3002
}

{$API_DOMAIN:api.wenotifyafrica.com} {
    reverse_proxy core-api:3010
}
