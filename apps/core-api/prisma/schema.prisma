// NotifyAfrica Core API — relational schema (00_Contexte_Global §19).
// Covers Phase A (Config Registry, Catalog, Pricing, Accounts, Notifications,
// Audit) with schema-level preparation for Phase D+ (Wallet/Ledger) and the
// future aggregator (04_Prompt §16: Provider/Route/mappings), so those areas
// don't require a breaking migration later even though their engines aren't
// wired yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Environment {
  sandbox
  production
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ConsoleRole {
  OWNER
  ADMIN
  BILLING_MANAGER
  DEVELOPER
  CAMPAIGN_MANAGER
  SUPPORT_AGENT
  VIEWER_AUDITOR
}

// Internal (Admin) roles per design lot 27, "Équipe interne & rôles".
enum InternalRole {
  SUPER_ADMIN
  FINANCE
  COMMERCIAL
  CONFORMITE
  SUPPORT
  TECHNIQUE
}

enum ConfigScope {
  GLOBAL
  COUNTRY
  ORGANIZATION
  PROJECT
}

enum ConfigStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  ACTIVE
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  BETA
  COMING_SOON
  PRIVATE
  DISABLED
}

enum MarkupType {
  PERCENT
  FIXED_AMOUNT
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
  UNIT_DISCOUNT
  FIXED_PRICE
  PROMO
  BONUS
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INFO_REQUIRED
  OFFER_AVAILABLE
  ACCEPTED
  REJECTED
  EXPIRED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  HOLD
  CAPTURE
  RELEASE
  REFUND
  ADJUSTMENT
}

enum PaymentMethodFamily {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  INVOICE
}

enum WhatsAppTemplateCategory {
  UTILITY
  AUTHENTICATION
  MARKETING
}

enum WhatsAppTemplateStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum WhatsAppNumberStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// SMS sender name / template usage (design handoff Lot 7 "Noms
/// d'expéditeur"/"Modèles"): the message's intent, which drives which
/// sender names an org can use and how templates are categorized.
enum SmsMessageUsage {
  TRANSACTIONAL
  MARKETING
  OTP
}

enum SenderNameStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  phone           String?
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  internalRole    InternalRole? // set only for Admin-app users
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships   Membership[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  country   String
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  projects     Project[]
  wallet       Wallet?
  quotes       Quote[]
  transactions Transaction[]
  messages     Message[]
  invitations  Invitation[]
  otpConfigs   OtpConfig[]
  campaigns    Campaign[]
  whatsappNumbers      WhatsAppNumber[]
  whatsappTemplates    WhatsAppTemplate[]
  whatsappConversations WhatsAppConversation[]
  senderNames          SenderName[]
  smsTemplates         SmsTemplate[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           ConsoleRole
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Project {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  environment    Environment @default(sandbox)
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys      ApiKey[]
  transactions Transaction[]
  messages     Message[]
  otpConfigs   OtpConfig[]
  campaigns    Campaign[]
  whatsappNumbers      WhatsAppNumber[]
  whatsappTemplates    WhatsAppTemplate[]
  whatsappConversations WhatsAppConversation[]
  senderNames          SenderName[]
  smsTemplates         SmsTemplate[]

  @@map("projects")
}

model ApiKey {
  id          String      @id @default(cuid())
  projectId   String
  name        String
  environment Environment
  hashedKey   String      @unique
  prefix      String
  scopes      String[]
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Team invitations (03_Specifications_Console §29, Lot 16). A pending
/// invitation is not a User yet — the invitee only gets one once they accept
/// (packages/auth RBAC gates who can invite: team.manage permission).
model Invitation {
  id              String           @id @default(cuid())
  organizationId  String
  email           String
  role            ConsoleRole
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  createdAt       DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

/// Generic Config Registry object (02_Specifications_Backoffice §31).
/// Each publish inserts a new row (never mutates a published one) so the
/// version/effectiveFrom/reason trail required by 00_Contexte_Global §9
/// falls out of the table itself.
model ConfigEntry {
  id             String       @id @default(cuid())
  key            String
  value          Json
  type           String
  scope          ConfigScope
  scopeId        String?
  environment    Environment  @default(sandbox)
  version        Int
  status         ConfigStatus @default(DRAFT)
  reason         String?
  authorId       String?
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  createdAt      DateTime     @default(now())

  @@unique([key, scope, scopeId, environment, version])
  @@index([key, scope, scopeId, environment, status])
  @@map("config_entries")
}

model CatalogProduct {
  id                 String        @id @default(cuid())
  key                String        @unique
  name               String
  slug               String        @unique
  category           String
  summary            String?
  description        String?
  icon               String?
  /// Short feature tags for the public product card (e.g. "Envoi en masse")
  /// — Website §9 lists "avantages" as part of the public catalog entry.
  features           String[]
  /// Billing unit label used to render "par {billingUnit}" on pricing
  /// surfaces (e.g. "message", "code vérifié") without hardcoding it in a
  /// component.
  billingUnit        String?
  countries          String[]
  status             ProductStatus @default(COMING_SOON)
  publicPageEnabled  Boolean       @default(false)
  order              Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("catalog_products")
}

model PricingRule {
  id             String     @id @default(cuid())
  productKey     String
  countryCode    String?
  operatorId     String?
  providerId     String?
  category       String?
  volumeMin      Int        @default(0)
  volumeMax      Int?
  currency       String
  baseCost       Decimal?   @db.Decimal(18, 6)
  basePrice      Decimal    @db.Decimal(18, 6)
  markupType     MarkupType @default(PERCENT)
  markupValue    Decimal    @default(0) @db.Decimal(9, 4)
  customerScope  ConfigScope @default(GLOBAL)
  organizationId String?
  priority       Int        @default(0)
  publicVisible  Boolean    @default(true)
  quoteRequired  Boolean    @default(false)
  status         ConfigStatus @default(DRAFT)
  version        Int        @default(1)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  reason         String?
  createdAt      DateTime   @default(now())

  @@index([productKey, countryCode, status])
  @@map("pricing_rules")
}

model DiscountRule {
  id             String       @id @default(cuid())
  type           DiscountType
  /// Product targeting is orthogonal to `scope`/`scopeId` (country/org/
  /// project) — same pattern as PricingRule.countryCode alongside
  /// customerScope/organizationId. Null = applies to every product.
  productKey     String?
  scope          ConfigScope
  scopeId        String?
  value          Decimal      @db.Decimal(18, 6)
  priority       Int          @default(0)
  stackable      Boolean      @default(false)
  maxDiscount    Decimal?     @db.Decimal(18, 6)
  usageLimit     Int?
  startAt        DateTime?
  endAt          DateTime?
  eligibility    Json?
  status         ConfigStatus @default(DRAFT)
  createdAt      DateTime     @default(now())

  @@map("discount_rules")
}

model Quote {
  id             String      @id @default(cuid())
  organizationId String
  productKey     String
  status         QuoteStatus @default(DRAFT)
  payload        Json
  assignedToUserId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("quotes")
}

model Wallet {
  id             String   @id @default(cuid())
  organizationId String   @unique
  currency       String
  availableMinor BigInt   @default(0)
  reservedMinor  BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@map("wallets")
}

model LedgerEntry {
  id          String          @id @default(cuid())
  walletId    String
  type        LedgerEntryType
  amountMinor BigInt
  reason      String?
  relatedTransactionId String?
  createdAt   DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("ledger_entries")
}

/// Every financial transaction freezes the pricing rule applied onto
/// `pricingSnapshot` (design handoff invariant #2) — never recomputed later.
model Transaction {
  id              String   @id @default(cuid())
  organizationId  String
  projectId       String?
  type            String
  amountMinor     BigInt
  currency        String
  pricingSnapshot Json
  status          String
  providerId      String?
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id])
  message      Message?
  otpCode      OtpCode?
  campaign     Campaign?

  @@map("transactions")
}

/// Payment methods catalog (02_Specifications_Backoffice §23,
/// 03_Specifications_Console §9). `instant: false` methods (bank transfer,
/// monthly invoicing) leave the resulting Transaction at PENDING until
/// Admin confirms receipt — see /api/admin/transactions/[id]/confirm.
model PaymentMethod {
  id         String              @id @default(cuid())
  name       String
  family     PaymentMethodFamily
  /// Eligible countries (ISO codes) — empty array means all countries.
  countries  String[]
  minAmount  Decimal?            @db.Decimal(18, 6)
  maxAmount  Decimal?            @db.Decimal(18, 6)
  feePercent Decimal             @default(0) @db.Decimal(9, 4)
  instant    Boolean             @default(true)
  status     String              @default("ACTIVE")
  createdAt  DateTime            @default(now())

  @@map("payment_methods")
}

/// SMS send record (03_Specifications_Console §10-13). One Transaction per
/// paid send holds the frozen pricing snapshot (design handoff invariant
/// #2); the Message row holds the send-specific fields (destination,
/// content, provider status) that don't belong on a generic Transaction.
model Message {
  id              String        @id @default(cuid())
  organizationId  String
  projectId       String
  product         String        @default("SMS")
  senderId        String?
  destination     String
  content         String
  status          MessageStatus @default(QUEUED)
  providerId      String?
  pricingSnapshot Json
  transactionId   String?       @unique
  /// Set only for messages sent as part of a Campaign — a single-send
  /// Message never has one. Campaigns don't create a Transaction per
  /// message (only one, for the whole batch, on Campaign.transactionId).
  campaignId      String?
  /// Set only for WhatsApp sends — the approved template used.
  whatsappTemplateId String?
  /// Set only when an SMS send referenced an SmsTemplate — bumps its usageCount.
  smsTemplateId   String?
  createdAt       DateTime      @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transaction      Transaction?      @relation(fields: [transactionId], references: [id])
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  whatsappTemplate WhatsAppTemplate? @relation(fields: [whatsappTemplateId], references: [id], onDelete: SetNull)
  smsTemplate      SmsTemplate?      @relation(fields: [smsTemplateId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([campaignId])
  @@map("messages")
}

/// Bulk send campaigns (03_Specifications_Console §12): Draft -> Channel ->
/// Audience -> Content -> Estimate -> Schedule -> Review -> Reserve Funds ->
/// Run -> Report. Launch holds funds for the whole estimated audience at
/// once (unitPrice * destinations.length); the Worker's job processor
/// (apps/worker/src/processors/campaign.ts) sends each destination, then
/// captures the actual spend and releases whatever wasn't used.
model Campaign {
  id              String         @id @default(cuid())
  organizationId  String
  projectId       String
  name            String
  product         String         @default("SMS")
  senderId        String?
  content         String
  destinations    String[]
  status          CampaignStatus @default(DRAFT)
  unitPrice       Decimal?       @db.Decimal(18, 6)
  currency        String?
  estimatedTotal  Decimal?       @db.Decimal(18, 6)
  heldAmountMinor BigInt?
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  totalCount      Int            @default(0)
  transactionId   String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transaction  Transaction? @relation(fields: [transactionId], references: [id])
  messages     Message[]

  @@index([organizationId, createdAt])
  @@map("campaigns")
}

/// WhatsApp Business sender numbers (03_Specifications_Console §16). No
/// real Meta number-verification flow is wired yet (design handoff README
/// §9 point 4) — a number is created directly as VERIFIED, since there's
/// no real pending-verification process to model honestly.
model WhatsAppNumber {
  id             String                @id @default(cuid())
  organizationId String
  projectId      String
  phoneNumber    String
  displayName    String
  status         WhatsAppNumberStatus  @default(VERIFIED)
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("whatsapp_numbers")
}

/// WhatsApp message templates require Meta approval before they can be
/// used to initiate a business conversation. Console drafts and submits;
/// Admin approves/rejects (standing in for the real Meta review — Lot 26
/// "Revue des modèles WhatsApp avant soumission à Meta" isn't designed
/// yet, but Lot 10 itself needs *some* approval gate before send).
model WhatsAppTemplate {
  id             String                   @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  category       WhatsAppTemplateCategory
  language       String                   @default("fr")
  bodyText       String
  status         WhatsAppTemplateStatus   @default(DRAFT)
  rejectionReason String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@map("whatsapp_templates")
}

/// WhatsApp Business is billed **per 24h conversation window with a
/// contact, not per message** (design handoff Lot 10 §I: "La facturation
/// est par conversation de 24 h, pas par message : les réponses dans la
/// fenêtre sont gratuites. La catégorie du premier message sortant fixe
/// le prix de la fenêtre.") — this mirrors Meta's own real WhatsApp
/// Business Platform billing model, not a design-only simplification.
/// One row per window actually opened (not upserted in place), so this
/// doubles as a real conversation history for analytics. A send checks
/// for a non-expired row for (organizationId, destination); if found, the
/// send is free and reuses that window's category; if not, the send is
/// priced normally and opens a new 24h window here.
model WhatsAppConversation {
  id             String                   @id @default(cuid())
  organizationId String
  projectId      String
  destination    String
  category       WhatsAppTemplateCategory
  openedAt       DateTime                 @default(now())
  expiresAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, destination, expiresAt])
  @@map("whatsapp_conversations")
}

/// SMS sender names must be validated per-country by each operator (design
/// handoff Lot 7 "Noms d'expéditeur") — modeled the same way WhatsApp
/// templates model Meta's review (Console submits, Admin approves/rejects),
/// since there's no real per-operator validation channel to integrate with
/// yet. `senderId` on Message/Campaign stays a free-text field: a rejected
/// or not-yet-validated name doesn't block sending (falls back to the
/// shared default), it just isn't offered as a *validated* option in the
/// Console picker.
model SenderName {
  id              String            @id @default(cuid())
  organizationId  String
  projectId       String
  name            String
  country         String
  usage           SmsMessageUsage   @default(TRANSACTIONAL)
  status          SenderNameStatus  @default(PENDING)
  rejectionReason String?
  createdAt       DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("sender_names")
}

/// Reusable SMS message bodies with `{variable}` placeholders (design
/// handoff Lot 7 "Modèles"). No approval gate, unlike sender names/WhatsApp
/// templates — these are an org's own internal drafts, nothing external
/// reviews them. `usageCount` increments each time a send references one
/// (apps/core-api/src/app/api/sms/send/route.ts), a real counter rather
/// than the mockup's illustrative numbers.
model SmsTemplate {
  id             String          @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  usage          SmsMessageUsage @default(TRANSACTIONAL)
  bodyText       String
  usageCount     Int             @default(0)
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@map("sms_templates")
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

/// OTP configuration (03_Specifications_Console §15) — one org can define
/// several, one per "app" (their own end-user application, not NotifyAfrica).
model OtpConfig {
  id                    String   @id @default(cuid())
  organizationId        String
  projectId             String
  name                  String
  length                Int      @default(6)
  expirySeconds         Int      @default(300)
  maxAttempts           Int      @default(3)
  resendCooldownSeconds Int      @default(60)
  channel               String   @default("SMS")
  fallbackChannel       String?
  template              String   @default("Votre code NotifyAfrica est {code}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codes        OtpCode[]

  @@map("otp_configs")
}

/// A single OTP code lifecycle. Only the hash is stored — never the
/// plaintext code (same principle as password/API-key storage).
model OtpCode {
  id             String    @id @default(cuid())
  configId       String
  organizationId String
  destination    String
  codeHash       String
  attempts       Int       @default(0)
  status         OtpStatus @default(PENDING)
  expiresAt      DateTime
  transactionId  String?   @unique
  createdAt      DateTime  @default(now())

  config      OtpConfig    @relation(fields: [configId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([organizationId, createdAt])
  @@map("otp_codes")
}

model Country {
  code      String  @id
  name      String
  dialCode  String
  currency  String
  timezone  String
  status    String  @default("ACTIVE")

  @@map("countries")
}

model Currency {
  code     String @id
  symbol   String
  decimals Int    @default(2)
  status   String @default("ACTIVE")

  @@map("currencies")
}

model Operator {
  id          String @id @default(cuid())
  name        String
  countryCode String
  code        String
  status      String @default("ACTIVE")

  @@map("operators")
}

/// Future aggregator concepts (04_Prompt §16). Schema exists now so the
/// Admin proxy/gateway config (04_Prompt §17) has somewhere to live; no
/// adapter/routing logic is implemented before Phase D+.
model Provider {
  id          String   @id @default(cuid())
  name        String
  type        String
  countryCode String?
  status      String   @default("ACTIVE")
  healthState String   @default("UNKNOWN")

  endpoints ProviderEndpoint[]
  routes    Route[]

  @@map("providers")
}

model ProviderEndpoint {
  id            String      @id @default(cuid())
  providerId    String
  environment   Environment @default(sandbox)
  baseUrl       String
  path          String
  method        String
  authType      String
  timeoutMs     Int         @default(10000)
  retryPolicy   Json?
  requestMapping  Json?
  responseMapping Json?
  errorMapping    Json?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_endpoints")
}

model Route {
  id          String  @id @default(cuid())
  productKey  String
  countryCode String?
  operatorId  String?
  providerId  String
  priority    Int     @default(0)
  strategy    String  @default("priority")
  status      String  @default("ACTIVE")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("routes")
}

model NotificationRule {
  id             String   @id @default(cuid())
  event          String
  active         Boolean  @default(true)
  channel        String
  audienceRole   String?
  recipientEmails String[]
  template       String?
  priority       Int      @default(0)
  createdAt      DateTime @default(now())

  @@map("notification_rules")
}

/// In-app Admin notification center entries (02_Specifications_Backoffice §5).
model Notification {
  id             String    @id @default(cuid())
  event          String
  organizationId String?
  userId         String?
  payload        Json
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  resource    String
  resourceId  String?
  before      Json?
  after       Json?
  ip          String?
  reason      String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
}
