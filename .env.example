# --- Domains (never hardcode these in app code) ---
PUBLIC_SITE_URL=http://localhost:3000
CONSOLE_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
CORE_API_URL=http://localhost:3010
DOCS_URL=http://localhost:3000/docs
STATUS_URL=http://localhost:3000/status

# --- Database ---
DATABASE_URL=postgresql://notifyafrica:notifyafrica@localhost:5432/notifyafrica?schema=public

# --- Redis (cache / queues) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=change-me-in-every-environment
AUTH_URL=http://localhost:3001

# --- Config resolution environment (sandbox|production) ---
NOTIFYAFRICA_ENV=sandbox

# --- Production only (VPS .env — see docs/DEPLOYMENT.md) ---
# Not used locally; docker-compose.prod.yml and infra/proxy/Caddyfile read
# these on the server. Leave unset for local dev.
# PUBLIC_SITE_DOMAIN=notifyafrica.com
# CONSOLE_DOMAIN=app.notifyafrica.com
# ADMIN_DOMAIN=admin.notifyafrica.com
# API_DOMAIN=api.notifyafrica.com
# ACME_EMAIL=you@notifyafrica.com
# POSTGRES_USER=notifyafrica
# POSTGRES_PASSWORD=replace-with-a-strong-random-value
# POSTGRES_DB=notifyafrica
